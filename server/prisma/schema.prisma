// Modelo de datos de SIGNAL.
//
// Se escribe para PostgreSQL (Supabase en producción) evitando tipos propios de
// Postgres, para que el schema siga siendo portable a SQLite si hiciera falta.
//
// Toda migración nueva debe dejar las tablas con RLS activado: ver la sección
// "Supabase" del README y la migración inicial.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
  // Comunicación: mensajes de contacto, datos de contacto y redes. No toca contenido.
  SOCIAL
}

enum NewsStatus {
  DRAFT
  REVIEW
  PUBLISHED
}

// Estado del borrador de una sección. Sin borrador pendiente, el campo es null.
enum DraftStatus {
  DRAFT
  REVIEW
}

// Grupo de una persona en «Nosotros»: el equipo, el comité consultivo o estudiantes.
enum TeamCategory {
  CORE
  ADVISORY
  STUDENTS
}

// Tipo de organización colaboradora, para agruparlas en «Nosotros».
enum CollaboratorType {
  ACADEMIC
  CIVIL_SOCIETY
  PUBLIC_SECTOR
  COMPANY
  OTHER
}

// Motivo que elige quien escribe por el formulario de contacto.
enum ContactReason {
  SPACE
  COLLABORATION
  PRESS
  RESEARCH
  SUPPORT
  OTHER
}

// Página de la landing a la que pertenece una sección.
enum Page {
  INICIO
  NOSOTROS
  NOTICIAS
  CONTACTO
  RECURSOS
  GALERIA
}

// Tipo de recurso del repositorio abierto.
enum ResourceKind {
  REPORT
  ARTICLE
  GUIDE
  PRESS_KIT
  OTHER
}

model User {
  id                 String    @id @default(uuid())
  // Siempre en minúsculas: lo normaliza la capa de servicio.
  email              String    @unique
  name               String
  role               Role
  passwordHash       String
  mustChangePassword Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime?
  // Se incrementa al cambiar la contraseña o al desactivar la cuenta, e invalida
  // los JWT emitidos antes.
  tokenVersion       Int       @default(0)
  // Las cuentas no se borran (la bitácora las referencia); se desactivan.
  active             Boolean   @default(true)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  newsAuthored  News[]     @relation("NewsAuthor")
  newsReviewed  News[]     @relation("NewsReviewer")
  sectionDrafts Section[]  @relation("SectionDraftAuthor")
  beaconsEdited Beacon[]
  uploads       Media[]
  auditLogs     AuditLog[]

  @@map("users")
}

// Configuración global del sitio. Es una sola fila (id = 1).
model SiteSettings {
  id                     Int      @id @default(1)
  siteName               String   @default("SIGNAL")
  tagline                String?
  logoLightId            String?
  logoLightAlt           String?
  logoDarkId             String?
  logoDarkAlt            String?
  faviconId              String?
  // { light: { fondo, superficie, texto, ... }, dark: { ... } }. Ver src/content/theme.ts.
  palette                Json
  // { cuerpo: <id>, titulos: <id> }, con ids de la lista de fuentes permitidas.
  fonts                  Json
  contactPhone           String?
  contactEmail           String?
  contactAddress         String?
  // [{ red, url, etiqueta }]
  socials                Json     @default("[]")
  accessibilityStatement String
  // Textos, columnas de enlaces y bloques visibles del pie. Ver src/content/footer.ts.
  footer                 Json     @default("{}")
  // Audiodescriptor: idioma, voz preferida y velocidad. Ver src/content/voice.ts.
  voice                  Json     @default("{}")
  updatedAt              DateTime @updatedAt
  updatedById            String?

  logoLight Media? @relation("LogoLight", fields: [logoLightId], references: [id], onDelete: SetNull)
  logoDark  Media? @relation("LogoDark", fields: [logoDarkId], references: [id], onDelete: SetNull)
  favicon   Media? @relation("Favicon", fields: [faviconId], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

// Bloque de contenido de la landing. `content` es lo publicado; los cambios de un
// editor van a `draftContent` y solo pasan a `content` cuando un admin los publica.
// La forma del JSON depende de `key` y se valida con src/content/sections.ts.
model Section {
  id             String       @id @default(uuid())
  key            String       @unique
  page           Page
  order          Int
  visible        Boolean      @default(true)
  content        Json
  draftContent   Json?
  draftStatus    DraftStatus?
  draftAuthorId  String?
  draftUpdatedAt DateTime?
  reviewNote     String?
  publishedAt    DateTime?
  updatedAt      DateTime     @updatedAt

  draftAuthor User? @relation("SectionDraftAuthor", fields: [draftAuthorId], references: [id])

  @@index([page, order])
  @@map("sections")
}

model News {
  id          String     @id @default(uuid())
  title       String
  slug        String     @unique
  // Bajada: texto plano, se usa en tarjetas y en la meta description.
  excerpt     String
  // Documento del editor (fuente de verdad) y su HTML saneado, que es lo que se
  // muestra en la landing.
  bodyJson    Json
  bodyHtml    String
  coverId     String?
  // Obligatorio si hay imagen: lo exige un CHECK en la base de datos.
  coverAlt    String?
  category    String
  status      NewsStatus @default(DRAFT)
  authorId    String
  reviewerId  String?
  reviewNote  String?
  submittedAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  cover    Media? @relation(fields: [coverId], references: [id], onDelete: Restrict)
  author   User   @relation("NewsAuthor", fields: [authorId], references: [id])
  reviewer User?  @relation("NewsReviewer", fields: [reviewerId], references: [id])

  @@index([status, publishedAt])
  @@map("news")
}

model TeamMember {
  id          String       @id @default(uuid())
  name        String
  position    String
  bio         String?
  // Datos opcionales de la card: área («Ingeniería»), formación y un correo
  // público (conviene el institucional).
  area        String?
  education   String?
  // Institución a la que pertenece («Universidad de Chile»).
  affiliation String?
  category    TeamCategory @default(CORE)
  email       String?
  photoId     String?
  photoAlt    String?
  // Encuadre no destructivo de la foto: { x, y, zoom }. Null = centrada, sin zoom.
  photoFrame  Json?
  // [{ red, url, etiqueta }]
  links       Json         @default("[]")
  order       Int
  visible     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  photo Media? @relation(fields: [photoId], references: [id], onDelete: Restrict)

  @@index([order])
  @@map("team_members")
}

model Collaborator {
  id          String           @id @default(uuid())
  name        String
  description String?
  url         String?
  type        CollaboratorType @default(OTHER)
  logoId      String?
  logoAlt     String?
  order       Int
  visible     Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  logo Media? @relation(fields: [logoId], references: [id], onDelete: Restrict)

  @@index([order])
  @@map("collaborators")
}

// Instituciones que respaldan el proyecto (financiamiento, patrocinio). No son
// colaboradores: se muestran en el pie de todas las páginas.
model Backer {
  id          String   @id @default(uuid())
  name        String
  // Cómo respalda, tal como se lee en el sitio: «Financia», «Patrocina»…
  kind        String
  description String?
  url         String?
  logoId      String?
  logoAlt     String?
  order       Int
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  logo Media? @relation(fields: [logoId], references: [id], onDelete: Restrict)

  @@index([order])
  @@map("backers")
}

// Foto de la galería. `name` es el pie de foto; el texto alternativo (`alt`) es siempre
// obligatorio: la galería es contenido, no decoración.
model GalleryItem {
  id        String   @id @default(uuid())
  name      String
  // Crédito de la foto: «Foto: Ana Rojas».
  credit    String?
  mediaId   String
  alt       String
  order     Int
  visible   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([order])
  @@map("gallery_items")
}

// Suscripción al boletín. Se guarda el momento y el texto exacto del consentimiento
// que la persona aceptó. `token` es el secreto de su enlace de baja. Una baja no borra
// la fila (así no se vuelve a escribir a quien pidió no recibir más), salvo que se
// pida eliminarla.
model Subscriber {
  id             String    @id @default(uuid())
  // Siempre en minúsculas.
  email          String    @unique
  name           String?
  consentAt      DateTime
  consentText    String
  unsubscribedAt DateTime?
  token          String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([createdAt])
  @@map("subscribers")
}

// Recurso del repositorio abierto: un documento que se descarga (PDF subido al sitio)
// y/o se consulta en otro lugar (DOI o repositorio institucional). Debe tener al menos
// uno de los tres; lo exige la API y también la base (CHECK en la migración).
model Resource {
  id          String       @id @default(uuid())
  title       String
  description String?
  kind        ResourceKind @default(OTHER)
  authors     String?
  // Fecha de publicación del documento (no la de carga al sitio).
  publishedOn DateTime?    @db.Date
  doi         String?
  externalUrl String?
  license     String?
  fileId      String?
  visible     Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  file Media? @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([publishedOn])
  @@map("resources")
}

// Ficha que la app Android lee en GET /beacons/:major/:minor. Los nombres de los
// campos en español son parte del contrato con la app: no se renombran.
model Beacon {
  id          String   @id @default(uuid())
  major       Int
  minor       Int
  titulo      String
  descripcion String
  ubicacion   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedById String?

  updatedBy User? @relation(fields: [updatedById], references: [id])

  @@unique([major, minor])
  @@map("beacons")
}

model Media {
  id           String   @id @default(uuid())
  storageKey   String   @unique
  url          String
  mimeType     String
  sizeBytes    Int
  width        Int?
  height       Int?
  originalName String
  uploadedById String?
  createdAt    DateTime @default(now())

  uploadedBy   User?          @relation(fields: [uploadedById], references: [id])
  newsCovers   News[]
  teamPhotos   TeamMember[]
  collabLogos  Collaborator[]
  backerLogos  Backer[]
  resources    Resource[]
  galleryItems GalleryItem[]
  logoLightOf  SiteSettings[] @relation("LogoLight")
  logoDarkOf   SiteSettings[] @relation("LogoDark")
  faviconOf    SiteSettings[] @relation("Favicon")

  @@map("media")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  // Verbo en mayúsculas: LOGIN_OK, NEWS_PUBLISH, BEACON_DELETE...
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@map("audit_logs")
}

model ContactMessage {
  id        String        @id @default(uuid())
  name      String
  email     String
  phone     String?
  subject   String?
  reason    ContactReason @default(OTHER)
  message   String
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([createdAt])
  @@map("contact_messages")
}
