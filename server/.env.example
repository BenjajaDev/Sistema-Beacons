# =====================================================================
# SIGNAL · variables de entorno del servidor
# Copia este archivo a server/.env y completa los valores.
# server/.env NUNCA se versiona (está en .gitignore).
# =====================================================================

# --- Servidor ---------------------------------------------------------
NODE_ENV=development
# La app Android apunta al puerto 3000: no lo cambies sin actualizar su BASE_URL.
PORT=3000
# 0.0.0.0 para que un teléfono en la misma red pueda conectarse.
HOST=0.0.0.0
# trace | debug | info | warn | error
LOG_LEVEL=info

# --- Base de datos (PostgreSQL) ----------------------------------------
# Desarrollo local: `npm run db:local` levanta un Postgres en el puerto 5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/signal"
#
# Supabase (Project Settings → Database → Connection string):
#  - DATABASE_URL: pooler en modo transacción (puerto 6543), para el servidor.
#      postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
#  - DIRECT_URL: conexión de sesión (puerto 5432), solo para `prisma migrate`.
#      postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DIRECT_URL=

# --- Panel de administración y sesión ----------------------------------
# Genera valores nuevos con: npm run secret   (distintos en cada entorno)
#
# Ruta secreta del panel: el panel solo existe en /<ADMIN_PATH>; cualquier otra
# ruta responde 404. NO uses prefijo VITE_: esas variables terminan en el bundle
# público. La ruta oculta reduce el ruido, pero la seguridad real son la sesión,
# los roles y el CSRF.
ADMIN_PATH=
# Firma de las sesiones (JWT) y de los tokens CSRF. Mínimo 32 caracteres, distintos entre sí.
JWT_SECRET=
CSRF_SECRET=
# Duración de la sesión, en horas.
SESSION_TTL_HOURS=8
# Cookies Secure (solo viajan por HTTPS; los navegadores las aceptan en http://localhost).
# Ponlo en false SOLO para probar el panel desde otro equipo de la red local por http.
# En producción es obligatorio true.
COOKIE_SECURE=true
# Carpeta con el build del panel (admin.html), relativa a server/.
ADMIN_DIST_DIR=../apps/web/dist/admin

# --- Protección del login -------------------------------------------------
# Intentos fallidos seguidos antes de bloquear la cuenta, y duración del bloqueo.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Intentos de login por IP cada 15 minutos, y peticiones a /api/admin por IP por minuto.
LOGIN_RATE_LIMIT=20
API_RATE_LIMIT=300

# --- Red --------------------------------------------------------------------
# Orígenes extra autorizados para llamar a la API con credenciales (separados por coma).
# Vacío = solo el mismo origen (lo normal: el servidor sirve la landing y el panel).
CORS_ORIGINS=
# Detrás de un proxy o balanceador (Render, Railway, Nginx...) ponlo en 1 para que
# el rate limit vea la IP real del visitante y las cookies Secure funcionen.
TRUST_PROXY=false
# Hosts extra permitidos para imágenes en la CSP (ej.: https://<ref>.supabase.co).
CSP_IMG_HOSTS=

# --- Usuarios iniciales (npm run seed) ---------------------------------
# El seed es idempotente: crea las cuentas que falten y no toca las existentes
# (ni su contraseña). Contraseñas de 12 caracteres o más. Al primer login se
# obliga a cambiarlas.
SEED_ADMIN_EMAIL=admin@ejemplo.cl
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administración SIGNAL
SEED_EDITOR_EMAIL=editor@ejemplo.cl
SEED_EDITOR_PASSWORD=
SEED_EDITOR_NAME=Equipo editorial

# --- Respaldos locales -------------------------------------------------
# Carpeta donde se guardan los respaldos (relativa a server/).
BACKUP_DIR=backups
# Cada cuántas horas el servidor hace un respaldo automático. 0 = desactivado.
BACKUP_INTERVAL_HOURS=24
# Cuántos respaldos se conservan; los más antiguos se borran.
BACKUP_KEEP=14
# Copia local de los beacons en el formato de la app. Se actualiza en cada cambio
# y la usa GET /beacons/:major/:minor si la base de datos no responde.
BEACON_SNAPSHOT_PATH=backups/beacons.snapshot.json

# --- Tests ---------------------------------------------------------------
# Base para las pruebas de integración. Se BORRA en cada ejecución, por eso su
# nombre debe terminar en _test. Sin esta variable, esas pruebas se omiten.
# TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/signal_test"
