{
  "name": "@signal/web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Landing pública y panel de administración de SIGNAL (dos builds separados).",
  "scripts": {
    "dev": "vite --config vite.public.config.ts",
    "dev:admin": "vite --config vite.admin.config.ts",
    "build": "npm run build:public && npm run build:admin && npm run check:bundle",
    "build:public": "vite build --config vite.public.config.ts",
    "build:admin": "vite build --config vite.admin.config.ts",
    "check:bundle": "node scripts/check-public-bundle.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "motion": "^14.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  }
}
